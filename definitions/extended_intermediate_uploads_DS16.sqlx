config {
  type: "operations",
  hasOutput: true,
  dependencies: ["fcn_extended_uploads_DS16"],
  tags: ["daily_updates"]
}

-- Ensure the target table exists
CREATE TABLE IF NOT EXISTS `mlab-collaboration.mm_preproduction.extended_intermediate_uploads_DS16`
PARTITION BY date
CLUSTER BY isValidBest, ServerContinent, ServerSite
OPTIONS (require_partition_filter = true);

BEGIN TRANSACTION;
  DECLARE target_date DATE DEFAULT (
    SELECT DATE_ADD(MAX(date), INTERVAL 1 DAY) 
    FROM `mlab-collaboration.mm_preproduction.extended_intermediate_uploads_DS16`
    WHERE date >= '2024-01-01'
  );

  IF target_date < CURRENT_DATE() THEN
    -- Delete the specific partition
    DELETE FROM `mlab-collaboration.mm_preproduction.extended_intermediate_uploads_DS16`
    WHERE date = target_date;

    -- Insert using the logic function
    INSERT INTO `mlab-collaboration.mm_preproduction.extended_intermediate_uploads_DS16`
    SELECT * FROM `mlab-collaboration.mm_preproduction.fcn_extended_uploads_DS16`(target_date);
  END IF;
COMMIT TRANSACTION;
